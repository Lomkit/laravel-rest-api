{
  "name": "lomkit/laravel-rest-api",
  "description": "A package to build quick and robust rest api for the Laravel framework.",
  "keywords": ["laravel", "rest", "api", "lomkit", "graphql"],
  "license": "MIT",
  "authors": [
    {
      "name": "Gautier Deleglise",
      "email": "gautier@lomkit.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.30"
  },
  "require-dev": {
    "dedoc/scramble": "^0.13",
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.32",
    "laravel/scout": "^11.0",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^12.0 || ^13.0",
    "tomasvotruba/type-coverage": "^2.5"
  },
  "suggest": {
    "dedoc/scramble": "Documents the API in OpenAPI through the package's Scramble extension.",
    "laravel/scout": "Required to use full-text search (search.text) on searchable models."
  },
  "conflict": {
    "dedoc/scramble": "<0.13 || >=0.14"
  },
  "autoload": {
    "psr-4": {
      "Lomkit\\Rest\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lomkit\\Rest\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "format": "pint",
    "lint": "pint --test"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lomkit\\Rest\\RestServiceProvider"
      ],
      "aliases": {
        "Rest": "Lomkit\\Rest\\Facades\\Rest"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
