<?php

namespace App\Rest\Resources;

use Illuminate\Validation\Rule;
use Lomkit\Rest\Fields\ID;
use Lomkit\Rest\Fields\Text;
use Lomkit\Rest\Relations\BelongsToMany;
use Lomkit\Rest\Tests\Fixtures\Newsroom\Topic;

class TopicResource extends Resource
{
    public static string $model = Topic::class;

    #[\Override]
    public function fields(): array
    {
        return [
            ID::make('id'),
            Text::make('name')->creationRules('required', Rule::unique(Topic::class, 'name')),
        ];
    }

    #[\Override]
    public function relations(): array
    {
        return [
            BelongsToMany::make('stories', RelatedStoryResource::class),
        ];
    }

    #[\Override]
    public function scopes(): array
    {
        return [];
    }

    #[\Override]
    public function limits(): array
    {
        return [
            10,
            25,
            50,
        ];
    }

    #[\Override]
    public function actions(): array
    {
        return [];
    }

    #[\Override]
    public function instructions(): array
    {
        return [];
    }
}
