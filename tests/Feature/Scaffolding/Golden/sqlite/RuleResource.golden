<?php

namespace App\Rest\Resources;

use Illuminate\Validation\Rule;
use Lomkit\Rest\Fields\ID;
use Lomkit\Rest\Fields\Text;
use Lomkit\Rest\Mutations\Contextual;
use Lomkit\Rest\Mutations\MutationContext;
use Lomkit\Rest\Tests\Fixtures\Newsroom\Rule as RuleModel;

class RuleResource extends Resource
{
    public static string $model = RuleModel::class;

    #[\Override]
    public function fields(): array
    {
        return [
            ID::make('id'),
            Text::make('name')
                ->creationRules('required', Rule::unique(RuleModel::class, 'name'))
                ->updateRules(Contextual::rule(fn (MutationContext $mutation) => Rule::unique(RuleModel::class, 'name')->ignore($mutation->key))),
            Text::make('pattern')->nullable(),
        ];
    }

    #[\Override]
    public function relations(): array
    {
        return [];
    }

    #[\Override]
    public function scopes(): array
    {
        return [];
    }

    #[\Override]
    public function limits(): array
    {
        return [
            10,
            25,
            50,
        ];
    }

    #[\Override]
    public function actions(): array
    {
        return [];
    }

    #[\Override]
    public function instructions(): array
    {
        return [];
    }
}
