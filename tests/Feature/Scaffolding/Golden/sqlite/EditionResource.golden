<?php

namespace App\Rest\Resources;

use Illuminate\Validation\Rule;
use Lomkit\Rest\Fields\ID;
use Lomkit\Rest\Fields\Text;
use Lomkit\Rest\Tests\Fixtures\Newsroom\Edition;

class EditionResource extends Resource
{
    public static string $model = Edition::class;

    #[\Override]
    public function fields(): array
    {
        return [
            ID::make('code')
                ->creatable()
                ->creationRules('required', Rule::unique(Edition::class, 'code')),
            Text::make('name')->creationRules('required'),
        ];
    }

    #[\Override]
    public function relations(): array
    {
        return [];
    }

    #[\Override]
    public function scopes(): array
    {
        return [];
    }

    #[\Override]
    public function limits(): array
    {
        return [
            10,
            25,
            50,
        ];
    }

    #[\Override]
    public function actions(): array
    {
        return [];
    }

    #[\Override]
    public function instructions(): array
    {
        return [];
    }
}
