{
    "$comment": "Copy of https://json-schema.org/draft/2020-12/meta/meta-data (BSD-3-Clause, Copyright (c) 2022 JSON Schema Specification Authors), with each $dynamicRef to #meta replaced by a $ref to the OpenAPI dialect",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://json-schema.org/draft/2020-12/meta/meta-data",
    "title": "Meta-data vocabulary meta-schema",
    "type": [
        "object",
        "boolean"
    ],
    "properties": {
        "title": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "default": true,
        "deprecated": {
            "type": "boolean",
            "default": false
        },
        "readOnly": {
            "type": "boolean",
            "default": false
        },
        "writeOnly": {
            "type": "boolean",
            "default": false
        },
        "examples": {
            "type": "array",
            "items": true
        }
    }
}
