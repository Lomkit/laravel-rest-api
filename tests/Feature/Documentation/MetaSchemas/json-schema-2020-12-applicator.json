{
    "$comment": "Copy of https://json-schema.org/draft/2020-12/meta/applicator (BSD-3-Clause, Copyright (c) 2022 JSON Schema Specification Authors), with each $dynamicRef to #meta replaced by a $ref to the OpenAPI dialect",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://json-schema.org/draft/2020-12/meta/applicator",
    "title": "Applicator vocabulary meta-schema",
    "type": [
        "object",
        "boolean"
    ],
    "properties": {
        "prefixItems": {
            "$ref": "#/$defs/schemaArray"
        },
        "items": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "contains": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "additionalProperties": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "properties": {
            "type": "object",
            "additionalProperties": {
                "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
            },
            "default": []
        },
        "patternProperties": {
            "type": "object",
            "additionalProperties": {
                "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
            },
            "propertyNames": {
                "format": "regex"
            },
            "default": []
        },
        "dependentSchemas": {
            "type": "object",
            "additionalProperties": {
                "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
            },
            "default": []
        },
        "propertyNames": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "if": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "then": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "else": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        },
        "allOf": {
            "$ref": "#/$defs/schemaArray"
        },
        "anyOf": {
            "$ref": "#/$defs/schemaArray"
        },
        "oneOf": {
            "$ref": "#/$defs/schemaArray"
        },
        "not": {
            "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
        }
    },
    "$defs": {
        "schemaArray": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "https://spec.openapis.org/oas/3.1/dialect/2024-11-10"
            }
        }
    }
}
